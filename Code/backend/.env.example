CONTACT_EMAIL=Eyeofaqaba@gmail.com
ENV=development

# required for the contact form to actually send email, leave blank and it
# will accept submissions but silently fail to deliver them (api_contact
# reports the failure to the visitor rather than pretending it worked)
# use a Gmail App Password (not the account password) if SMTP_HOST is gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# optional, published-to-web CSV url for each tab of the content spreadsheet
# leave blank and the site just uses backend/snapshot.json instead
SHEET_CSV_WATERPARKS=
SHEET_CSV_ATTRACTIONS=
SHEET_CSV_CAR_RENTALS=
SHEET_CSV_POSTS=
SHEET_CSV_FAQ=
SHEET_CSV_SETTINGS=

# optional, Apps Script web app url that logs a click to the "clicks" tab
# see ../../Files/apps_script_clicks_webhook.gs for the script + setup steps
# leave blank and click tracking just quietly does nothing
CLICKS_WEBHOOK_URL=
