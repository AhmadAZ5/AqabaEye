CONTACT_EMAIL=Eyeofaqaba@gmail.com
ENV=development

# optional, published-to-web CSV url for each tab of the content spreadsheet
# leave blank and the site just uses backend/snapshot.json instead
SHEET_CSV_WATERPARKS=
SHEET_CSV_ATTRACTIONS=
SHEET_CSV_POSTS=
SHEET_CSV_FAQ=
SHEET_CSV_SETTINGS=

# optional, Apps Script web app url that logs a click to the "clicks" tab
# see ../../Files/apps_script_clicks_webhook.gs for the script + setup steps
# leave blank and click tracking just quietly does nothing
CLICKS_WEBHOOK_URL=
